# BarberOS — environment template. Copy to .env per environment; never commit real values.
# All configuration is environment-driven (12-factor, docs/09-devops-cicd.md §4).

# PostgreSQL
ConnectionStrings__Database=Host=postgres;Port=5432;Database=barberos;Username=barberos;Password=CHANGE_ME

# JWT (HS256 para v1; upgrade a RS256 antes de producción con alta carga)
Jwt__Secret=CHANGE_ME_USE_LONG_RANDOM_SECRET_MIN_32_CHARS
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Production
